# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env and edit. Nothing here is secret. No real IPs live in this repo;
# replace the YOUR_*_HOST placeholders and loopback defaults with wherever YOUR
# servers actually run.
#
# Two doors for images, two mechanisms (see examples/dsh.md):
#   DOOR 1  image attached in chat  -> the vision PROXY (shim/vision_shim.py)
#   DOOR 2  image file on disk       -> the analyze_image TOOL (plugin/vision/)
# Both call a local vision model (the "eyes"); the same model can serve both.
# ─────────────────────────────────────────────────────────────────────────────

# ═══ The eyes: a local vision server ════════════════════════════════════════
# setup.sh brings one up on this port (the fast VLM) and proves it serves.
VISION_PORT=8081

# ═══ DOOR 1: the vision proxy ═══════════════════════════════════════════════
# The proxy rewrites chat image attachments into text before they reach the
# brain. Env below, or pass the matching CLI flag (which overrides env).
# Set RUN_PROXY=1 to have setup.sh start it too.
# RUN_PROXY=0

SHIM_HOST=127.0.0.1
SHIM_PORT=8900
SHIM_LOG=1

# --- your text-only brain (the proxy forwards to it), CLI flag: --upstream ---
# ANY OpenAI-compatible endpoint: vLLM, llama.cpp, Ollama, LM Studio, a remote box.
VISION_TARGET=http://127.0.0.1:8000

# --- the proxy's vision model, CLI flags: --vision-url / --vision-model ------
EYES_URL=http://127.0.0.1:8081/v1/chat/completions
EYES_MODEL=mlx-community/Qwen3.5-0.8B-MLX-8bit
EYES_TIMEOUT=90

# If you run the eyes on Ollama instead (Moondream / Qwen2.5-VL, see MODELS.md):
#   EYES_URL=http://127.0.0.1:11434/v1/chat/completions
#   EYES_MODEL=moondream

# --- proxy description behaviour --------------------------------------------
# 0 = one clear sentence (fast). 1 = long, transcribes visible text (slower).
EYES_DETAIL=0
# EYES_MAX_TOKENS=120
# EYES_PROMPT=Describe what you see in one clear sentence.

# ═══ DOOR 2: the analyze_image tool backends ════════════════════════════════
# The plugin POSTs image files to these two vision servers. Two roles:
#   fast     = a tiny (~0.8B) VLM for colours, layout, coarse content. The default.
#   detailed = a larger VLM for small text, fine detail.
# These can also be read from the plugin config block instead of env.

VISION_FAST_URL=http://YOUR_FAST_VISION_HOST:8081/v1/chat/completions
VISION_FAST_MODEL=your-fast-vlm

VISION_DETAILED_URL=http://YOUR_DETAILED_VISION_HOST:8010/v1/chat/completions
VISION_DETAILED_MODEL=your-detailed-vlm
